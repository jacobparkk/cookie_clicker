<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Build a cosmic bakery, discover flavors, and chase the perfect batch."><title>Crumb & Cosmos</title><link rel="stylesheet" href="/style.css"></head>
<body><main class="app">
<header><div><p class="eyebrow">AN INTERSTELLAR BAKERY</p><h1>Crumb <i>&</i> Cosmos</h1></div><div class="header-actions"><button id="sound" aria-pressed="true">♪</button><button id="save">Save</button></div></header>
<section class="dashboard">
<aside class="panel progression"><div class="currency"><span>Cookies baked</span><strong id="cookies">0</strong><small><b id="cps">0</b> per second</small></div>
<div class="mission"><span>Current order</span><strong id="missionTitle">Bake 100 cookies</strong><div class="bar"><i id="missionBar"></i></div><small id="missionReward">Reward: 25 stardust</small></div>
<h2>Bakery stats</h2><dl><div><dt>Stardust</dt><dd id="dust">0</dd></div><div><dt>Crumbs</dt><dd id="crumbs">0</dd></div><div><dt>Best combo</dt><dd id="bestCombo">0</dd></div><div><dt>Total baked</dt><dd id="total">0</dd></div></dl>
<button id="prestige" class="prestige" disabled>Reopen bakery <small>Reset for permanent crumbs</small></button></aside>
<section class="oven">
<div id="sky" class="sky"></div><div class="combo"><span>COMBO</span><strong id="combo">×1.0</strong><div class="bar"><i id="comboBar"></i></div></div>
<button id="cookie" class="cookie" aria-label="Bake a cookie"><span class="chips">•　•<br>　•　 •<br>•　　•</span></button>
<p id="flavorName">Classic Orbit</p><div class="click-value">+<b id="clickValue">1</b> per click</div><button id="flavor" class="secondary">Change flavor</button>
</section>
<aside class="panel store"><div class="tabs"><button class="active" data-tab="buildings">Bakery</button><button data-tab="upgrades">Lab</button><button data-tab="achievements">Badges</button></div><div id="shop"></div></aside>
</section>
<footer><span>Autosaves every 10 seconds · offline earnings included</span><button id="reset">Reset save</button></footer>
</main><dialog id="flavors"><button class="close">×</button><p class="eyebrow">SIGNATURE FLAVORS</p><h2>Choose today's recipe</h2><div id="flavorGrid"></div></dialog><div id="toast" role="status"></div><script src="/game.js"></script></body></html>
